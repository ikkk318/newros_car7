# CargoCmd.srv —— 搬货服务（顶升 / 下降二合一）
# ------------------------------------------------------------------
# ★ 这是全项目唯一与"搬货机器"打交道的地方，也是后续接真实硬件的唯一改动点：
#   现在：只维护"搬货中"标志（话题 /agv/cargo/busy），立即返回成功，不驱动机器。
#   将来：在服务实现里加上真正的顶升/下降动作与到位判断即可，外部接口不变。
#
# busy 语义：顶升成功 → busy=true（正在搬货）；下降成功 → busy=false（空闲）。

string command      # "lift" = 顶升（开始搬货）/ "lower" = 下降（放货完成）
string request_id   # 请求号（追踪用，可为空）
---
bool   ok           # 是否受理成功
bool   busy         # 执行后的"搬货中"状态
string message      # 中文回执
